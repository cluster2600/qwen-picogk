#!/usr/bin/env python3
"""Generate one PicoGK C# answer with a qualified, explicitly pinned AM adapter."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent
RUNTIME = ROOT.parent
TRUSTED_PROFILE_SHA256 = None
API_GUIDANCE = (
    'PicoGK 2.3 API: using Library lib = new(0.2f); new Lattice(lib); '
    'lattice.AddSphere(Vector3,float); lattice.AddBeam(Vector3,float,Vector3,float,bool); '
    'new Voxels(lattice); new Voxels(mesh); new Voxels(existingVoxels); '
    'new Voxels(lib,IImplicit,BBox3); IImplicit.fSignedDistance(in Vector3); '
    'voxels.Offset(float) is outward for positive millimetres; voxels.BoolSubtract(other); '
    'voxels.BoolAdd(other); voxels.BoolIntersect(other); voxels.Trim(BBox3); '
    'voxels.CalculateProperties(out float volume,out BBox3 bounds); '
    'Mesh.mshFromStlFile(args[0],Mesh.EStlUnit.MM,libSet:lib); new Mesh(voxels); new Mesh(lib); '
    'mesh.nTriangleCount(); mesh.GetTriangle(i,out Vector3 a,out Vector3 b,out Vector3 c); '
    'mesh.nAddTriangle(a,b,c); voxels.SaveToVdbFile(path); mesh.SaveToStlFile(path,Mesh.EStlUnit.MM). '
    'Real types are Voxels, Mesh, Lattice and System.Numerics.Vector3; VoxelMatrix and PolyMesh do not exist. '
    'Give a brief explanation and one compact, complete csharp fence with Main(string[] args). '
    'args[0] is the input file and args[1] the output directory. Dispose native objects before Library. '
    'Export the actual field as part.vdb and its mesh as part.stl in millimetres. '
    'Drop exactly zero-area facets using a double-precision cross product before STL export. '
    'Outputs are geometric candidates only: manufacturing_authorized=false. '
    'If required measurements or oriented range evidence are absent or malformed, write refused.json '
    'with status=needs_measurement and missing inputs; do not invent geometry or interfaces. '
    'Do not claim fitment, structural qualification, support elimination or residual-stress safety. '
    'Use finite-value input validation; no network, subprocesses, reflection, unsafe code or GUI.'
)
spec = importlib.util.spec_from_file_location('am_prompt_infer', ROOT/'infer.py')
infer = importlib.util.module_from_spec(spec)
spec.loader.exec_module(infer)
BASE_NAMES = infer.base_runtime.BASE_NAMES


def unique(pairs):
    result = {}
    for key, value in pairs:
        if key in result: raise ValueError('Duplicate JSON field: '+key)
        result[key] = value
    return result


def read(path):
    return json.loads(path.read_text(), object_pairs_hook=unique)


def contained(root, value):
    path = Path(value)
    if path.is_absolute() or '..' in path.parts:
        raise ValueError('Profile paths must remain relative to the AM work directory.')
    resolved = (root/path).resolve(strict=True)
    if not resolved.is_relative_to(root.resolve()):
        raise ValueError('Profile path escaped its fixed directory.')
    return resolved


def verify_profile(work, runtime, trusted_hash):
    if not isinstance(trusted_hash, str) or len(trusted_hash) != 64:
        raise ValueError('AM C# serving is unavailable until a trusted qualified profile is installed.')
    profile_path = contained(work, 'qualified-profile.json')
    if infer.digest(profile_path) != trusted_hash:
        raise ValueError('Qualified AM profile differs from its trusted installation hash.')
    profile = read(profile_path)
    if (profile.get('schema') != 'picogk.am.qualified-profile@1' or profile.get('status') != 'qualified'
            or profile.get('manufacturing_authorized') is not False):
        raise ValueError('A qualified AM C# profile is required.')
    base_files = profile['model_files_sha256']
    if not isinstance(base_files, dict) or set(base_files) != BASE_NAMES:
        raise ValueError('All nine pinned base/tokenizer files are required.')
    explicit = {'base_profile', 'base_profile_sha256'}.intersection(profile)
    if explicit and explicit != {'base_profile', 'base_profile_sha256'}:
        raise ValueError('Serving base profile path and SHA-256 must be supplied together.')
    if explicit:
        if not isinstance(profile['base_profile_sha256'], str) or len(profile['base_profile_sha256']) != 64:
            raise ValueError('Serving base profile requires an exact SHA-256.')
        base = infer.base_runtime.verify_base(work, contained(work, profile['base_profile']),
            expected_profile_sha256=profile['base_profile_sha256'])
    else:
        base = infer.base_runtime.verify_base(work, runtime=runtime)
    if base_files != base['model_files_sha256']:
        raise ValueError('AM profile must use the verified pinned base/tokenizer manifest.')
    adapter = contained(work, profile['adapter'])
    for name, key in (('adapters.safetensors', 'adapter_sha256'), ('adapter_config.json', 'adapter_config_sha256')):
        if infer.digest(contained(adapter, name)) != profile[key]:
            raise ValueError('Qualified adapter file changed: '+name)
    receipt_path = contained(work, profile['final_receipt'])
    if infer.digest(receipt_path) != profile['final_receipt_sha256']:
        raise ValueError('Final qualification receipt changed.')
    receipt = read(receipt_path)
    spec = importlib.util.spec_from_file_location('am_prompt_final_qualification', Path(__file__).with_name('final_qualification.py'))
    final = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(final)
    if (receipt.get('schema') != 'picogk.am.final-qualification@1' or receipt.get('status') != 'qualified'
            or receipt.get('manufacturing_authorized') is not False
            or receipt.get('qualification') != 'software and geometry only'
            or receipt.get('total') != 12 or receipt.get('final_passes', 0) < 11
            or not final.complete_final_checks(receipt.get('checks'))):
        raise ValueError('Complete final software/geometry qualification is required.')
    for key, expected in (('base_weights_sha256', base_files['model.safetensors']),
                          ('adapter_sha256', profile['adapter_sha256']),
                          ('adapter_config_sha256', profile['adapter_config_sha256'])):
        if receipt.get(key) != expected:
            raise ValueError('Final qualification describes a different model: '+key)
    infer.base_runtime.verify_evidence(base, receipt)
    return profile, adapter


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    prompts = parser.add_mutually_exclusive_group(required=True)
    prompts.add_argument('--prompt')
    prompts.add_argument('--prompt-file', type=Path)
    parser.add_argument('--output', type=Path, required=True, help='new output directory under the AM work directory')
    args = parser.parse_args(argv)
    try:
        output = args.output.resolve()
        if not output.is_relative_to(ROOT) or output.exists():
            raise ValueError('Use a new output directory under '+str(ROOT))
        if args.prompt_file and args.prompt_file.stat().st_size > 65536:
            raise ValueError('Prompt exceeds 64 KiB.')
        prompt = args.prompt_file.read_text() if args.prompt_file else args.prompt
        if not prompt.strip() or len(prompt.encode()) > 65536:
            raise ValueError('A nonempty prompt of at most 64 KiB is required.')
        prompt = API_GUIDANCE+'\n\nUser request:\n'+prompt
        profile, adapter = verify_profile(ROOT, RUNTIME, TRUSTED_PROFILE_SHA256)
        receipt = infer.run_generation([{'id': 'answer', 'prompt': prompt}], output, adapter,
            hashlib.sha256(prompt.encode()).hexdigest(),
            preflight=lambda: verify_profile(ROOT, RUNTIME, TRUSTED_PROFILE_SHA256),
            **({'base_profile': contained(ROOT, profile['base_profile'])} if 'base_profile' in profile else {}))
        receipt.update(profile_sha256=TRUSTED_PROFILE_SHA256,
            final_qualification_receipt_sha256=profile['final_receipt_sha256'],
            geometry_executed=False, manufacturing_authorized=False)
        (output/'receipt.json').write_text(json.dumps(receipt, indent=2)+'\n')
        if not receipt['all_stopped']:
            raise ValueError('Response did not reach EOS; incomplete text and receipts were preserved.')
        print(str(output/'answer.txt'))
        return 0
    except (OSError, ValueError, KeyError, TypeError) as error:
        parser.exit(1, str(error)+'\n')


if __name__ == '__main__':
    raise SystemExit(main())
